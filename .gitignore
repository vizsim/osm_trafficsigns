# --- data outputs ---
*.parquet
*.osm.pbf
*.geojson
*.shp
*.gpkg

# --- viz build artefacts (regenerated by scripts) ---
# Track pmtiles (publishable map data) but ignore intermediate geojson +
# extracted sign_colors.json (regenerated by extract_sign_colors.py).
viz/data/*
!viz/data/*.pmtiles
!viz/data/sign_colors.json
viz/symbols

# --- Python build / venv ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
